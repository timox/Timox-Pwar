if(CASE STREQUAL "help")
    set(arguments --help)
    set(expected_exit 0)
    set(expected_text "Usage:")
elseif(CASE STREQUAL "unknown")
    set(arguments --unknown)
    set(expected_exit 2)
    set(expected_text "Unknown option")
elseif(CASE STREQUAL "port")
    set(arguments --port 8321junk)
    set(expected_exit 2)
    set(expected_text "Invalid value")
elseif(CASE STREQUAL "missing")
    set(arguments --ip)
    set(expected_exit 2)
    set(expected_text "Missing value")
elseif(CASE STREQUAL "address")
    set(arguments --ip 999.1.1.1)
    set(expected_exit 2)
    set(expected_text "Invalid IPv4")
elseif(CASE STREQUAL "buffer")
    set(arguments --buffer_size -1)
    set(expected_exit 2)
    set(expected_text "Invalid value")
elseif(CASE STREQUAL "check")
    set(arguments --ip 127.0.0.1 --port 18321 --buffer_size 128 --check-config)
    set(expected_exit 0)
    set(expected_text "Configuration valid")
else()
    message(FATAL_ERROR "Unknown CLI audit case")
endif()
execute_process(COMMAND "${CLI}" ${arguments} RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 3)
if(NOT "${result}" STREQUAL "${expected_exit}" OR NOT "${output}${error}" MATCHES "${expected_text}")
    message(FATAL_ERROR "CLI ${CASE}: exit=${result}, expected=${expected_exit}; stdout=${output}; stderr=${error}")
endif()
if("${output}${error}" MATCHES "Starting PWAR|socket|bind failed")
    message(FATAL_ERROR "CLI ${CASE} unexpectedly entered audio/network startup")
endif()
